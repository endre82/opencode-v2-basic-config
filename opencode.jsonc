{
  "$schema": "https://opencode.ai/config.json",

  // Default model for new sessions
  "model": "ollama-cloud/glm-5.3-flash",

  // Start every new session with the plan agent
  "default_agent": "plan",

  // Role variants: temperature + reasoning effort ride on request-body overlays.
  // reasoning_effort values verified against Ollama OpenAI-compat API (low|high|max);
  // omit the field entirely for the provider default. Catalog: models.dev.
  "providers": {
    "ollama-cloud": {
      "models": {
        "glm-5.3-flash": {
          "variants": [
            // Built-in plan agent (default thinking)
            { "id": "plan", "body": { "temperature": 0.6 } },
            // Engineer/planner subagent (high thinking)
            { "id": "planner", "body": { "temperature": 0.6, "reasoning_effort": "high" } },
            // Developer/coder
            { "id": "code", "body": { "temperature": 0.1, "reasoning_effort": "low" } }
          ]
        },
        "deepseek-v4.1-flash": {
          "variants": [
            // Reviewer
            { "id": "review", "body": { "temperature": 0.3, "reasoning_effort": "high" } }
          ]
        }
      }
    }
  },

  // Global git guardrails — apply to every agent in every project, including subagents
  // (developer previously had unrestricted shell; this closes that hole).
  // Ordering (docs/permissions): base defaults → project rules → global rules → agent
  // rules, last match wins. Global rules append AFTER project rules, so a project
  // config cannot silently allow these.
  "permissions": [
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git * push *", "effect": "deny" },
    { "action": "shell", "resource": "git commit *", "effect": "ask" }
  ],

  // Absolute backstop for push (docs/permissions#policies): evaluated after
  // permission rules AND saved "Allow always" approvals; turns allow/ask into deny
  // and never grants access. Even an agent-level rule like plan's `shell * → ask`
  // or a project redefining agents cannot re-enable push.
  "experimental": {
    "policies": [
      { "action": "permission", "resource": "shell:git push *", "effect": "deny" },
      { "action": "permission", "resource": "shell:git * push *", "effect": "deny" }
    ]
  },

  // Subagents: system prompts are composed here, referenced via {file:...}
  // (relative to this config file's directory; expansion happens pre-parse,
  // so references must live here, not inside the prompt files).
  "agents": {
    // Built-in plan agent: pin planning model variant (default thinking), mirror planning permissions, UI color.
    "plan": {
      "mode": "primary",
      "model": "ollama-cloud/glm-5.3-flash#plan",
      "color": "#5C9CF5",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "~/.opencode/plan/*", "effect": "allow" },
        { "action": "external_directory", "resource": "~/.opencode/plan/*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "subagent", "resource": "developer", "effect": "deny" }
      ]
    },

    // Built-in build agent: pin coding model variant and UI color; keep prompt
    // untouched. Push protection lives in the global guardrails above.
    "build": {
      "mode": "primary",
      "model": "ollama-cloud/glm-5.3-flash#code",
      "color": "#C057FF"
    },

    "engineer": {
      "description": "Planning subagent. Launch to produce a detailed implementation plan. Pass a self-contained brief: goal, constraints, codebase pointers, expected output. Returns the complete plan with an implementation-units table (developer-subagent vs build-direct per unit). Never edits project files.",
      "mode": "subagent",
      "model": "ollama-cloud/glm-5.3-flash#planner",
      "system": "{file:./prompts/shared.md}\n\n---\n\n{file:./prompts/engineer.md}",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "~/.opencode/plan/*", "effect": "allow" },
        { "action": "external_directory", "resource": "~/.opencode/plan/*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "question", "resource": "*", "effect": "deny" }
      ]
    },
    "developer": {
      "description": "Coding subagent. Launch to implement an approved plan or a self-contained coding task. Pass the plan verbatim with codebase pointers. Returns a change report: what was implemented, files changed, verification results, deviations. Makes minimal focused diffs, matches existing style.",
      "mode": "subagent",
      "model": "ollama-cloud/glm-5.3-flash#code",
      "system": "{file:./prompts/shared.md}\n\n---\n\n{file:./prompts/developer.md}",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "question", "resource": "*", "effect": "deny" }
      ]
    },
    "reviewer": {
      "description": "Review subagent. Launch to review a completed plan (pre-implementation) or the current changes/diff (post-implementation). Pass the artifact plus intent. Returns findings in severity order with file/line references and a verdict: APPROVE, APPROVE WITH CHANGES, or REQUEST CHANGES. Read-only.",
      "mode": "subagent",
      "model": "ollama-cloud/deepseek-v4.1-flash#review",
      "system": "{file:./prompts/shared.md}\n\n---\n\n{file:./prompts/reviewer.md}",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "question", "resource": "*", "effect": "deny" }
      ]
    }
  }
}
